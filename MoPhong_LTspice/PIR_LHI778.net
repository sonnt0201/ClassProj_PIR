* D:\User\Documents\Cảm biến và xử lý tín hiệu đo\MoPhong_LTspice\PIR_LHI778.asc
* Generated by LTspice 26.1.1 for Windows.
VAC PA N001 AC 1
BIRA N001 0 V=IRA(time)
BIRB PB 0 V=IRB(time)
BQA 0 TA I=ETA*1e-6*V(PA)
CTA TA 0 {HTH}
RTA TA 0 {1/GTH}
BQB 0 TB I=ETA*1e-6*V(PB)
CTB TB 0 {HTH}
RTB TB 0 {1/GTH}
BPYA M G I=PPY*AEL*ddt(V(TA))
BPYB M 0 I=PPY*(1-MISM)*AEL*ddt(V(TB))
CEA G M {CE}
CEB M 0 {CE}
RLA G M 1T
RLB M 0 1T
RG G 0 68G
J1 VDD G S JLHI
CEMI S 0 47p
RS S 0 47k
BN SN S V=VNOISE(time)
X§U1A SN N003 VDD 0 A1 AD8608 ;§pnba In+)In-)V+)V-)OUT
R2 A1 N003 1Meg
C2 A1 N003 10n
R1 N003 N004 10k
C1 N004 0 47µ
C3 N007 A1 1µ
R3 N007 VREF 470k
X§U1B N007 N002 VDD 0 A2 AD8608 ;§pnba In+)In-)V+)V-)OUT
R5 A2 N002 150k
C4 A2 N002 68n
R4 N002 VREF 10k
X§U1C N006 A3 VDD 0 A3 AD8608 ;§pnba In+)In-)V+)V-)OUT
R6 N005 A2 100k
R7 N006 N005 100k
C5 A3 N005 220n
C6 N006 VREF 100n
R8 OUT A3 10k
R9 OUT 0 100k
V1 VDD 0 3.3
R10 VDD N008 100k
R11 N008 0 100k
C7 N008 0 10µ
X§U1D N008 VREF VDD 0 VREF AD8608 ;§pnba In+)In-)V+)V-)OUT
.model NJF NJF
.model PJF PJF
.lib C:\Users\Admin\AppData\Local\LTspice\lib\cmp\standard.jft
* MO PHONG CAM BIEN PIR LHI778 + MACH KHUECH DAI VA LOC THONG THAP  (nguon 3.3 V, dau ra 0..3 V, muc nghi 1.5 V)
* Luong tin hieu:  buc xa IR (PA, PB) -> mo hinh nhiet (TA, TB) -> 2 phan tu nhiet dien + FET (chan S) -> khuech dai 2 tang (A1, A2) -> loc Sallen-Key (A3) -> chia ap -> OUT
* (1) BUC XA IR TOI 2 PHAN TU [1 V = 1 uW]
* VAC: nguon thu AC (1 uW len phan tu A),\nchi co tac dung khi chay .ac
* (2) MO HINH NHIET: H.dT/dt + G.T = eta.P  [1 V = 1 K]
* LHI778 - MO HINH TUONG DUONG\n2 phan tu nhiet dien noi tiep nguoc cuc + FET (source follower)
* D
* S
* G
* Phan tu A = BPYA // CEA // RLA  (P_A tang -> V(G) tang)\nPhan tu B = BPYB // CEB // RLB  (noi nguoc cuc -> chi con tin hieu vi sai P_A - P_B)
* tau_E = RG.(CE/2 + Cin) = 2.5 s ;  tau_T = H/G = 0.6 s\nDo nhay mo phong R(1 Hz) = 4.0 kV/W  (datasheet LHi 778: 3.3 min / 4.0 typ)
* (3) MACH NGOAI: chan D noi VDD = 3.3 V,\n     R_S = 47 k (tai nguon theo datasheet)
* (4) NHIEU gop vao duong tin hieu:\n     50 Hz (dien luoi) + 1 kHz + nhieu trang\n     SN = S + nhieu
* (5) MACH KHUECH DAI VA LOC (AD8608: 4 op-amp rail-to-rail trong 1 IC, nguon don 3.3 V)
* Tang 1 (khuech dai khong dao): K1 = 1 + R2/R1 = 101\nthong cao: fc = 1/(2.pi.R1.C1) = 0.34 Hz\nthong thap: fc = 1/(2.pi.R2.C2) = 16 Hz\nDC: C1 ho mach -> K = 1 -> V(A1) = V(S) = 0.81 V
* Ghep AC: fc = 1/(2.pi.R3.C3) = 0.34 Hz\n(dua muc DC ve VREF = 1.65 V)\nTang 2: K2 = 1 + R5/R4 = 16\nthong thap: fc = 1/(2.pi.R5.C4) = 15.6 Hz
* Loc thong thap Sallen-Key bac 2 (Butterworth), R6 = R7 = R:\nf0 = 1/(2.pi.R.sqrt(C5.C6)) = 10.7 Hz,  Q = 0.5.sqrt(C5/C6) = 0.74\n-> loai nhieu tan so cao bien do nho (50 Hz, 1 kHz, nhieu trang)
* Chia ap dau ra: OUT = V(A3).R9/(R8+R9) = 0.909.V(A3)\n-> op-amp ra 0..3.3 V  =>  OUT 0..3.0 V\n-> khong chuyen dong: 1.65 V x 0.909 = 1.50 V
* (6) NGUON 3.3 V VA DIEN AP THAM CHIEU VREF = VDD/2 = 1.65 V (dat ao cho tin hieu xoay chieu)
* VREF = 3.3 V x R11/(R10+R11) = 1.65 V; C7 loc nhieu nguon;\nU1D: mach lap dien ap (voltage follower) cho VREF tro khang thap
* ===== THONG SO MO HINH LHI778 (datasheet LHi 778 / PYD 1378) =====
.param AEL=2e-6    ; dien tich 1 phan tu 2x1 mm2 [m2]
.param DEL=50e-6   ; be day phan tu gom nhiet dien [m]
.param EPSR=200    ; hang so dien moi tuong doi cua gom PZT
.param CV=2.6e6    ; nhiet dung rieng the tich [J/(m3.K)]
.param PPY=3.7e-4  ; he so nhiet dien p [C/(m2.K)]
.param ETA=0.75    ; he so hap thu x truyen qua cua so loc IR
.param TAUT=0.6    ; hang so thoi gian nhiet tau_T = H/G [s]
.param MISM=0.01   ; do lech 2 phan tu (Match) = 1 %
.param HTH={CV*AEL*DEL}  ; nhiet dung H [J/K]
.param GTH={HTH/TAUT}    ; do dan nhiet G [W/K]
.param CE={EPSR*8.854e-12*AEL/DEL}  ; dien dung 1 phan tu [F]
.model JLHI NJF(Vto=-1.0 Beta=4.5e-4 Lambda=0.02 Cgs=2p Cgd=1p Is=1e-15)
* ===== KICH BAN CHUYEN DONG: P = buc xa IR toi phan tu [uW] =====
.func gp(x,c,w) {exp(-(x-c)*(x-c)/(w*w))}
.func sstep(x,c,d) {0.5*(1+tanh(2*(x-c)/d))}
.func walk(x,s,T,w,n) {gp(x,s,w)+if(n>1,gp(x,s+T,w),0)+if(n>2,gp(x,s+2*T,w),0)+if(n>3,gp(x,s+3*T,w),0)}
.param P1=0.13 T1=0.8 W1=0.15 S1=3   ; SK1 3-6 s: nguoi di binh thuong (~3 m)
.param P2=0.35 T2=0.5 W2=0.09 S2=10  ; SK2 10-12 s: nguoi di nhanh / o gan (~1.5 m)
.param P3=0.04 T3=1.4 W3=0.25 S3=15  ; SK3 15-19 s: nguoi di cham / o xa (~6 m)
.param P4=2 S4=22 END4=26 RT4=1      ; SK4 22-26 s: buc xa nen tang DEU tren ca 2 phan tu
.param P5=0.12 S5=31 RT5=0.3         ; SK5 tu 31 s: vat nong xuat hien roi DUNG YEN
.func IRA(x) {P1*walk(x,S1,T1,W1,4)+P2*walk(x,S2,T2,W2,4)+P3*walk(x,S3,T3,W3,3)+P4*(sstep(x,S4,RT4)-sstep(x,END4,RT4))+P5*sstep(x,S5,RT5)}
.func IRB(x) {P1*walk(x,S1+T1/2,T1,W1,4)+P2*walk(x,S2+T2/2,T2,W2,4)+P3*walk(x,S3+T3/2,T3,W3,3)+P4*(sstep(x,S4,RT4)-sstep(x,END4,RT4))}
* ===== NHIEU gop vao chan S (NOISE=0 de tat) =====
.param NOISE=1 A50=50u AHF=50u AWN=10u
.func VNOISE(x) {NOISE*(A50*sin(2*pi*50*x)+AHF*sin(2*pi*1k*x)+2*AWN*white(2k*x))}
* ===== MO PHONG =====
.options gmin=1e-15  ; giam ro gia qua tiep giap JFET (RG = 68 GOhm)
.save V(pa) V(pb) V(ta) V(tb) V(g) V(m) V(s) V(sn) V(a1) V(a2) V(a3) V(out) V(vref) I(BPYA) I(BPYB)
* (xoa dong .save neu muon do them cac nut khac)
.tran 0 40 0 0.1m
* .ac dec 100 0.01 1k
* ^ Muon ve dap ung tan so: chuot phai vao 2 dong tren, doi .tran thanh Comment\n  va .ac thanh SPICE directive. Khi do: V(S)*1e6 = do nhay cam bien [V/W],\n  V(OUT)/V(S) = he so khuech dai cua mach khuech dai + loc.
* ===== DO LUONG AC (chi co hieu luc khi chay .ac) =====
.meas AC R_1HZ   FIND mag(V(S))*1e6 AT=1     ; do nhay LHI778 [V/W]
.meas AC K_1HZ   FIND mag(V(OUT)/V(S)) AT=1  ; he so khuech dai o 1 Hz
.meas AC K_MAX   MAX  mag(V(OUT)/V(S))
.meas AC K_50HZ  FIND mag(V(OUT)/V(S)) AT=50
.meas AC K_1KHZ  FIND mag(V(OUT)/V(S)) AT=1k
* ===== DO LUONG (xem View > SPICE Error Log) =====
.meas TRAN VS_DC   AVG V(S)   FROM 0.5 TO 2.5
.meas TRAN VOUT_NGHI AVG V(OUT) FROM 0.5 TO 2.5
.meas TRAN VOUT_MAX MAX V(OUT)
.meas TRAN VOUT_MIN MIN V(OUT)
.meas TRAN NHIEU_TRUOC_LOC PP V(A2) FROM 0.5 TO 2.5
.meas TRAN NHIEU_SAU_LOC   PP V(A3) FROM 0.5 TO 2.5
.meas TRAN SK1_PP PP V(OUT) FROM 2.5 TO 9.5
.meas TRAN SK2_PP PP V(OUT) FROM 9.5 TO 14.5
.meas TRAN SK3_PP PP V(OUT) FROM 14.5 TO 21.5
.meas TRAN SK4_PP PP V(OUT) FROM 21.5 TO 30.5
.meas TRAN SK5_PP PP V(OUT) FROM 30.5 TO 40
.meas TRAN VOUT_CUOI AVG V(OUT) FROM 39 TO 40
* Library below included based on ModelFile attribute of instance X§U1A, X§U1B, X§U1C, X§U1D (C:\Users\Admin\AppData\Local\LTspice\lib\sym\OpAmps\AD8608.asy)
.lib ADI.lib
.backanno
.end
