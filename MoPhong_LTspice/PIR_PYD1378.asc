RECTANGLE Normal 976 -96 2016 448 2
TEXT -32 -304 Left 4 ;MO PHONG CAM BIEN PIR PYD1378 + MACH KHUECH DAI VA LOC THONG THAP  (nguon 3.3 V, dau ra 0..3 V, muc nghi 1.5 V)
TEXT -32 -240 Left 2 ;Luong tin hieu:  buc xa IR (PA, PB) -> mo hinh nhiet (TA, TB) -> 2 phan tu nhiet dien + FET (chan S) -> khuech dai 2 tang (A1, A2) -> loc Sallen-Key (A3) -> chia ap -> OUT
TEXT -32 -144 Left 2 ;(1) BUC XA IR TOI 2 PHAN TU [1 V = 1 uW]
TEXT -32 272 Left 1 ;VAC: nguon thu AC (1 uW len phan tu A),\nchi co tac dung khi chay .ac
TEXT 512 -112 Left 2 ;(2) MO HINH NHIET: H.dT/dt + G.T = eta.P  [1 V = 1 K]
TEXT 992 -80 Left 2 ;PYD1378 - MO HINH TUONG DUONG\n2 phan tu nhiet dien noi tiep nguoc cuc + FET (source follower)
TEXT 1968 -32 Left 2 ;D
TEXT 1968 64 Left 2 ;S
TEXT 1968 192 Left 2 ;G
TEXT 992 288 Left 1 ;Phan tu A = BPYA // CEA // RLA  (P_A tang -> V(G) tang)\nPhan tu B = BPYB // CEB // RLB  (noi nguoc cuc -> chi con tin hieu vi sai P_A - P_B)
TEXT 992 352 Left 1 ;tau_E = RG.(CE/2 + Cin) = 2.5 s ;  tau_T = H/G = 0.6 s\nDo nhay mo phong R(1 Hz) = 4.0 kV/W  (datasheet PYD 1378: 3.3 min / 4.0 typ)
TEXT 2080 -144 Left 2 ;(3) MACH NGOAI: chan D noi VDD = 3.3 V,\n     R_S = 47 k (tai nguon theo datasheet)
TEXT 2080 288 Left 2 ;(4) NHIEU gop vao duong tin hieu:\n     50 Hz (dien luoi) + 1 kHz + nhieu trang\n     SN = S + nhieu
TEXT -32 560 Left 2 ;(5) MACH KHUECH DAI VA LOC (AD8608: 4 op-amp rail-to-rail trong 1 IC, nguon don 3.3 V)
TEXT -32 616 Left 1 ;Tang 1 (khuech dai khong dao): K1 = 1 + R2/R1 = 101\nthong cao: fc = 1/(2.pi.R1.C1) = 0.34 Hz\nthong thap: fc = 1/(2.pi.R2.C2) = 16 Hz\nDC: C1 ho mach -> K = 1 -> V(A1) = V(S) = 0.81 V
TEXT 544 616 Left 1 ;Ghep AC: fc = 1/(2.pi.R3.C3) = 0.34 Hz\n(dua muc DC ve VREF = 1.65 V)\nTang 2: K2 = 1 + R5/R4 = 16\nthong thap: fc = 1/(2.pi.R5.C4) = 15.6 Hz
TEXT 1008 616 Left 1 ;Loc thong thap Sallen-Key bac 2 (Butterworth), R6 = R7 = R:\nf0 = 1/(2.pi.R.sqrt(C5.C6)) = 10.7 Hz,  Q = 0.5.sqrt(C5/C6) = 0.74\n-> loai nhieu tan so cao bien do nho (50 Hz, 1 kHz, nhieu trang)
TEXT 1536 616 Left 1 ;Chia ap dau ra: OUT = V(A3).R9/(R8+R9) = 0.909.V(A3)\n-> op-amp ra 0..3.3 V  =>  OUT 0..3.0 V\n-> khong chuyen dong: 1.65 V x 0.909 = 1.50 V
TEXT -32 1152 Left 2 ;(6) NGUON 3.3 V VA DIEN AP THAM CHIEU VREF = VDD/2 = 1.65 V (dat ao cho tin hieu xoay chieu)
TEXT -32 1504 Left 1 ;VREF = 3.3 V x R11/(R10+R11) = 1.65 V; C7 loc nhieu nguon;\nU1D: mach lap dien ap (voltage follower) cho VREF tro khang thap
TEXT 832 1216 Left 2 !* ===== THONG SO MO HINH PYD1378 (datasheet PYD 1378) =====\n.param AEL=2e-6    ; dien tich 1 phan tu 2x1 mm2 [m2]\n.param DEL=50e-6   ; be day phan tu gom nhiet dien [m]\n.param EPSR=200    ; hang so dien moi tuong doi cua gom PZT\n.param CV=2.6e6    ; nhiet dung rieng the tich [J/(m3.K)]\n.param PPY=3.7e-4  ; he so nhiet dien p [C/(m2.K)]\n.param ETA=0.75    ; he so hap thu x truyen qua cua so loc IR\n.param TAUT=0.6    ; hang so thoi gian nhiet tau_T = H/G [s]\n.param MISM=0.01   ; do lech 2 phan tu (Match) = 1 %\n.param HTH={CV*AEL*DEL}  ; nhiet dung H [J/K]\n.param GTH={HTH/TAUT}    ; do dan nhiet G [W/K]\n.param CE={EPSR*8.854e-12*AEL/DEL}  ; dien dung 1 phan tu [F]\n.model JPYD NJF(Vto=-1.0 Beta=4.5e-4 Lambda=0.02 Cgs=2p Cgd=1p Is=1e-15)
TEXT 832 1600 Left 2 !* ===== KICH BAN CHUYEN DONG: P = buc xa IR toi phan tu [uW] =====\n.func gp(x,c,w) {exp(-(x-c)*(x-c)/(w*w))}\n.func sstep(x,c,d) {0.5*(1+tanh(2*(x-c)/d))}\n.func walk(x,s,T,w,n) {gp(x,s,w)+if(n>1,gp(x,s+T,w),0)+if(n>2,gp(x,s+2*T,w),0)+if(n>3,gp(x,s+3*T,w),0)}\n.param P1=0.13 T1=0.8 W1=0.15 S1=3   ; SK1 3-6 s: nguoi di binh thuong (~3 m)\n.param P2=0.35 T2=0.5 W2=0.09 S2=10  ; SK2 10-12 s: nguoi di nhanh / o gan (~1.5 m)\n.param P3=0.04 T3=1.4 W3=0.25 S3=15  ; SK3 15-19 s: nguoi di cham / o xa (~6 m)\n.param P4=2 S4=22 END4=26 RT4=1      ; SK4 22-26 s: buc xa nen tang DEU tren ca 2 phan tu\n.param P5=0.12 S5=31 RT5=0.3         ; SK5 tu 31 s: vat nong xuat hien roi DUNG YEN\n.func IRA(x) {P1*walk(x,S1,T1,W1,4)+P2*walk(x,S2,T2,W2,4)+P3*walk(x,S3,T3,W3,3)+P4*(sstep(x,S4,RT4)-sstep(x,END4,RT4))+P5*sstep(x,S5,RT5)}\n.func IRB(x) {P1*walk(x,S1+T1/2,T1,W1,4)+P2*walk(x,S2+T2/2,T2,W2,4)+P3*walk(x,S3+T3/2,T3,W3,3)+P4*(sstep(x,S4,RT4)-sstep(x,END4,RT4))}
TEXT 2016 1216 Left 2 !* ===== NHIEU gop vao chan S (NOISE=0 de tat) =====\n.param NOISE=1 A50=50u AHF=50u AWN=10u\n.func VNOISE(x) {NOISE*(A50*sin(2*pi*50*x)+AHF*sin(2*pi*1k*x)+2*AWN*white(2k*x))}
TEXT 2016 1344 Left 2 !* ===== MO PHONG =====\n.options gmin=1e-15  ; giam ro gia qua tiep giap JFET (RG = 68 GOhm)\n.save V(pa) V(pb) V(ta) V(tb) V(g) V(m) V(s) V(sn) V(a1) V(a2) V(a3) V(out) V(vref) I(BPYA) I(BPYB)\n* (xoa dong .save neu muon do them cac nut khac)
TEXT 2016 1488 Left 3 !.tran 0 40 0 0.1m
TEXT 2016 1536 Left 3 ;.ac dec 100 0.01 1k
TEXT 2016 1584 Left 1 ;^ Muon ve dap ung tan so: chuot phai vao 2 dong tren, doi .tran thanh Comment\n  va .ac thanh SPICE directive. Khi do: V(S)*1e6 = do nhay cam bien [V/W],\n  V(OUT)/V(S) = he so khuech dai cua mach khuech dai + loc.
TEXT 2016 1680 Left 2 !* ===== DO LUONG AC (chi co hieu luc khi chay .ac) =====\n.meas AC R_1HZ   FIND mag(V(S))*1e6 AT=1     ; do nhay PYD1378 [V/W]\n.meas AC K_1HZ   FIND mag(V(OUT)/V(S)) AT=1  ; he so khuech dai o 1 Hz\n.meas AC K_MAX   MAX  mag(V(OUT)/V(S))\n.meas AC K_50HZ  FIND mag(V(OUT)/V(S)) AT=50\n.meas AC K_1KHZ  FIND mag(V(OUT)/V(S)) AT=1k
TEXT 832 1936 Left 2 !* ===== DO LUONG (xem View > SPICE Error Log) =====\n.meas TRAN VS_DC   AVG V(S)   FROM 0.5 TO 2.5\n.meas TRAN VOUT_NGHI AVG V(OUT) FROM 0.5 TO 2.5\n.meas TRAN VOUT_MAX MAX V(OUT)\n.meas TRAN VOUT_MIN MIN V(OUT)\n.meas TRAN NHIEU_TRUOC_LOC PP V(A2) FROM 0.5 TO 2.5\n.meas TRAN NHIEU_SAU_LOC   PP V(A3) FROM 0.5 TO 2.5\n.meas TRAN SK1_PP PP V(OUT) FROM 2.5 TO 9.5\n.meas TRAN SK2_PP PP V(OUT) FROM 9.5 TO 14.5\n.meas TRAN SK3_PP PP V(OUT) FROM 14.5 TO 21.5\n.meas TRAN SK4_PP PP V(OUT) FROM 21.5 TO 30.5\n.meas TRAN SK5_PP PP V(OUT) FROM 30.5 TO 40\n.meas TRAN VOUT_CUOI AVG V(OUT) FROM 39 TO 40
